# Copy to .env (or a systemd EnvironmentFile) and fill in only what you use.
# Every source is optional: a tool whose source is not configured answers with
# a *_NOT_CONFIGURED reason instead of failing.

# ══ MCP server ═══════════════════════════════════════════
# Bearer token for direct MCP clients. Generate: openssl rand -hex 32
# MCP_AUTH_TOKEN=

# Public URL where this server is reachable (OAuth resource metadata and the
# DNS-rebinding allowlist). Local-only default:
MCP_PUBLIC_URL=http://127.0.0.1:8100

# OAuth 2.1 (optional, needs MCP_AUTH_TOKEN), for hosted clients such as ChatGPT
# or claude.ai behind your own HTTPS reverse proxy. Dynamic client registration
# plus an owner passphrase gate (hash: python owner_gate.py hash, stored as the
# owner-gate credential under CREDENTIALS_DIRECTORY); state in KINVEST_OAUTH_STATE_DIR.
# MCP_OAUTH_ENABLED=true
# KINVEST_OAUTH_STATE_DIR=/var/lib/k-invest/oauth
# OWNER_GATE_REDIRECT_ORIGINS=https://claude.ai,https://chatgpt.com
# Manual OAuth client (optional, connector UIs that ask for an ID/secret):
# MCP_OAUTH_CLIENT_ID=k-invest-<hex>
# MCP_OAUTH_CLIENT_SECRET=<secret>
# MCP_OAUTH_TOKEN_TTL=3600

# Loopback service token (optional): a file holding a token that lets a local
# service call the read-only allowlist (see service_auth.py). chmod 600.
# KINVEST_SERVICE_TOKEN_FILE=/path/to/service-token
# Credential files (binance-futures-api-key, binance-futures-signing-key,
# dashboard-token, oauth-client-secret) are read from systemd's
# CREDENTIALS_DIRECTORY when it is set.

# ══ Toss Securities Open API ═════════════════════════════
# 발급: 토스증권 WTS 로그인 → 설정 → Open API
TOSS_CLIENT_ID=your_client_id_here
TOSS_CLIENT_SECRET=your_client_secret_here
# Multi-account (optional): JSON file, chmod 600
#   {"accounts": [{"label": "primary", "client_id": "...", "client_secret": "..."}]}
# TOSS_CREDS_FILE=/path/to/toss_creds.json
# Last four digits of the Toss account to label 'InvestMCP 전용' in statement imports (optional).
# KINVEST_TOSS_INVESTMCP_ACCOUNT_SUFFIX=

# ══ Korea Investment & Securities Open API (optional) ════
# 발급: https://apiportal.koreainvestment.com
# KIS_APP_KEY=
# KIS_APP_SECRET=
# KIS_CANO=              # 계좌번호 앞 8자리
# KIS_ACNT_PRDT_CD=01    # 계좌 상품 코드 (뒤 2자리)
# KIS_URL_BASE=https://openapi.koreainvestment.com:9443
# Or reuse an existing env file with APP_KEY/APP_SECRET/CANO/ACNT_PRDT_CD:
# KIS_ENV_FILE=/path/to/kis.env
# Several KIS accounts with the same app key (optional):
#   KIS_ACCOUNTS_JSON={"accounts": [{"label": "isa", "cano": "...", "acnt_prdt_cd": "01"}]}

# ══ Crypto (optional, read-only) ═════════════════════════
# Binance USD-M futures: a read-only API key (no trading, no withdrawals) and its
# RSA signing key (PEM), as files.
# BINANCE_FUTURES_API_KEY_FILE=/path/to/binance-futures-api-key
# BINANCE_FUTURES_SIGNING_KEY_FILE=/path/to/binance-futures-signing-key
# Hyperliquid: public account addresses only (no keys), comma separated.
# HYPERLIQUID_ACCOUNT_ADDRESSES=0x...

# ══ SEC EDGAR (optional but recommended) ═════════════════
# SEC asks for a descriptive User-Agent with a real contact address.
# SEC_USER_AGENT=k-invest/2.15 (you@your-domain.tld)

# ══ Look-through exposure (optional) ═════════════════════
# JSON map of leveraged/single-stock products to their underlyings; see
# product_map.example.json. Without it every product is reported unmapped.
# KINVEST_PRODUCT_MAP_FILE=/path/to/product_map.json

# ══ Storage (optional) ═══════════════════════════════════
# Token cache directory (default: ~/.cache/k-invest)
# KINVEST_CACHE_DIR=
# KINVEST_PORTFOLIO_DB=   # NAV snapshot / ledger SQLite file
# KINVEST_STATEMENT_INBOX= # folder of Toss PDF statements for statement import
# TOSS_TOKEN_CACHE=       # Toss token cache override (direct TossClient use)
# KIS_TOKEN_CACHE=        # single-file override, KIS token
